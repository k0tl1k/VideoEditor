<UserControl x:Class="VideoEditor.UI.Controls.ProgramMonitor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Border Style="{StaticResource PanelBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Program Monitor" Style="{StaticResource TitleTextStyle}" Margin="0" />
                <TextBlock Text="{Binding PreviewTitle}"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           DockPanel.Dock="Right" />
            </DockPanel>

            <Border Grid.Row="1" Background="#0F1217" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="4" Padding="6">
                <Grid>
                    <Rectangle Fill="#11151C" RadiusX="3" RadiusY="3" />

                    <MediaElement x:Name="PreviewMediaElement"
                                  Source="{Binding PreviewPlayableMediaSource}"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  Stretch="Uniform"
                                  MediaOpened="PreviewMediaElement_MediaOpened"
                                  MediaEnded="PreviewMediaElement_MediaEnded"
                                  MediaFailed="PreviewMediaElement_MediaFailed"
                                  Visibility="{Binding IsPreviewPlayableMedia, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Image Source="{Binding PreviewImageSource}"
                           Stretch="Uniform"
                           Visibility="{Binding IsPreviewImage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock Text="Preview"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsPreviewPlaceholderVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Border Background="#AA0F1217"
                            CornerRadius="4"
                            Padding="8,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="8">
                        <TextBlock Text="{Binding PreviewStatusText}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" />
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="|&lt;" Width="44" Command="{Binding StopPreviewCommand}" />
                <Button Content="Pause" Width="64" Command="{Binding PausePreviewCommand}" />
                <Button Content="Play" Width="72" Command="{Binding PlayPreviewCommand}" />
                <Button Content="Stop" Width="64" Command="{Binding StopPreviewCommand}" Margin="0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
