<Window x:Class="VideoEditor.UI.Windows.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoEditor"
        Width="860"
        Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Border Padding="28"
            Background="{StaticResource AppBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Width="42"
                        Height="42"
                        CornerRadius="12"
                        Background="#1D324A"
                        Margin="0,0,12,0">
                    <Image Width="22"
                           Height="22"
                           Tag="app-logo.svg"
                           Source="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource IconFileToImageSourceConverter}}" />
                </Border>
                <StackPanel>
                    <TextBlock Text="VideoEditor"
                               FontSize="24"
                               FontWeight="Black"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Start a project"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1"
                  Margin="0,28,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource PanelBorderStyle}"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="New project"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,14" />
                        <TextBlock Text="Project name"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,5" />
                        <TextBox x:Name="ProjectNameTextBox"
                                 Text="Diploma Project"
                                 MinHeight="34"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,18" />
                        <Button Content="Create"
                                Width="120"
                                HorizontalAlignment="Left"
                                Click="CreateButton_Click" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource PanelBorderStyle}"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Open project"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,14" />
                        <TextBlock Text="Load a .vedproj file"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,18" />
                        <Button Width="132"
                                HorizontalAlignment="Left"
                                Click="OpenButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="14"
                                       Height="14"
                                       Margin="0,0,8,0"
                                       Tag="folder.svg"
                                       Source="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource IconFileToImageSourceConverter}}" />
                                <TextBlock Text="Open" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="SelectedProjectTextBlock"
                                   Text=""
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,16,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Style="{StaticResource PanelBorderStyle}"
                        Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Recent"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="Open a recent project"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,12" />
                        </StackPanel>

                        <ListBox x:Name="RecentProjectsListBox"
                                 Grid.Row="1"
                                 ItemsSource="{Binding RecentProjects}"
                                 MouseDoubleClick="RecentProjectsListBox_MouseDoubleClick"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FilePath}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="NoRecentProjectsTextBlock"
                                   Grid.Row="1"
                                   Text="No recent projects"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />

                        <Button Grid.Row="2"
                                Content="Open recent"
                                Width="124"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0"
                                Click="OpenRecentButton_Click" />
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="96"
                        Margin="0"
                        Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
