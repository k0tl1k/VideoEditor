<Window x:Class="VideoEditor.UI.Windows.ExportSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export"
        Width="520"
        Height="560"
        MinWidth="480"
        MinHeight="520"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#151A21" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="ExportComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="#151A21"
                                BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                      Width="8"
                                      Height="4"
                                      Fill="{StaticResource TextMutedBrush}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#19212B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#151A21" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Style="{StaticResource ExportComboBoxToggleButtonStyle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="10,0,34,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False" />

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#11161D"
                                            BorderBrush="{StaticResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="4">
                                        <ScrollViewer>
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Popup" Property="MinHeight" Value="30" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#151A21" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#223044" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1F3A55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="#10141A" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>
    <Border x:Name="RootBorder"
            Background="{StaticResource PanelChromeBrush}"
            BorderBrush="{StaticResource BorderBrushDark}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="18"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="0"
                              Color="#66000000"
                              Opacity="0.62" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Export settings" Style="{StaticResource TitleTextStyle}" FontSize="16" />
                    <TextBlock Text="Choose where to save the rendered MP4 and tune FFmpeg encoding options."
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Output file" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding ExportOutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="28"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,8,0" />
                                                                        <Button Grid.Column="1"
                                Command="{Binding BrowseExportOutputPathCommand}"
                                Margin="0"
                                Tag="folder.svg"
                                ToolTip="Browse">
                            <Image Width="14"
                                   Height="14"
                                   Source="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Tag, Converter={StaticResource IconFileToImageSourceConverter}}" />
                        </Button>
                    </Grid>

                    <TextBlock Text="File type" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                    <ComboBox SelectedValue="{Binding ExportFileType, Mode=TwoWay}"
                              SelectedValuePath="Content"
                              Margin="0,0,0,12">
                        <ComboBoxItem Content="MP4" />
                        <ComboBoxItem Content="MOV" />
                        <ComboBoxItem Content="MKV" />
                    </ComboBox>

                    <TextBlock Text="Export range" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                    <CheckBox Content="Custom range"
                              IsChecked="{Binding UseCustomExportRange, Mode=TwoWay}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" IsEnabled="{Binding UseCustomExportRange}">
                            <TextBlock Text="Start, sec" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3" />
                            <TextBox Text="{Binding ExportRangeStartSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}"
                                     MinHeight="28"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" IsEnabled="{Binding UseCustomExportRange}">
                            <TextBlock Text="End, sec" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3" />
                            <TextBox Text="{Binding ExportRangeEndSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}"
                                     MinHeight="28"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding ExportRangeLabel}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               Margin="0,0,0,12" />

                    <TextBlock Text="Resolution" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                    <ComboBox SelectedValue="{Binding ExportResolutionPreset, Mode=TwoWay}"
                              SelectedValuePath="Content"
                              Margin="0,0,0,8">
                        <ComboBoxItem Content="1920x1080" />
                        <ComboBoxItem Content="1280x720" />
                        <ComboBoxItem Content="2560x1440" />
                        <ComboBoxItem Content="3840x2160" />
                        <ComboBoxItem Content="1080x1920" />
                        <ComboBoxItem Content="Custom" />
                    </ComboBox>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Width" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3" />
                            <TextBox Text="{Binding ExportWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="28"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Height" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3" />
                            <TextBox Text="{Binding ExportHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="28"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="FPS" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                    <Slider Minimum="24"
                            Maximum="60"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding ExportFrameRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,0,2" />
                    <TextBlock Text="{Binding ExportFrameRate, StringFormat=FPS: {0}}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               Margin="0,0,0,12" />

                    <TextBlock Text="Quality (CRF, lower is better)" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                    <Slider Minimum="18"
                            Maximum="30"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding ExportConstantRateFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,0,2" />
                    <TextBlock Text="{Binding ExportConstantRateFactor, StringFormat=CRF: {0}}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               Margin="0,0,0,12" />

                    <TextBlock Text="Video codec" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                    <ComboBox SelectedValue="{Binding ExportVideoCodec, Mode=TwoWay}"
                              SelectedValuePath="Content"
                              Margin="0,0,0,12">
                        <ComboBoxItem Content="H.264" />
                        <ComboBoxItem Content="H.265" />
                        <ComboBoxItem Content="MPEG-4" />
                    </ComboBox>

                    <TextBlock Text="Preset" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                    <ComboBox SelectedValue="{Binding ExportPreset, Mode=TwoWay}"
                              SelectedValuePath="Content"
                              Margin="0,0,0,12">
                        <ComboBoxItem Content="ultrafast" />
                        <ComboBoxItem Content="veryfast" />
                        <ComboBoxItem Content="fast" />
                        <ComboBoxItem Content="medium" />
                        <ComboBoxItem Content="slow" />
                    </ComboBox>

                    <TextBlock Text="Audio bitrate" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                    <Slider Minimum="96"
                            Maximum="320"
                            TickFrequency="32"
                            IsSnapToTickEnabled="True"
                            Value="{Binding ExportAudioBitrateKbps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,0,2" />
                    <TextBlock Text="{Binding ExportAudioBitrateKbps, StringFormat=Audio: {0} kbps}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Progress" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Height="10"
                                 Value="{Binding ExportProgressPercent, Mode=OneWay}"
                                 Margin="0,0,0,6" />
                    <TextBlock Text="{Binding ExportProgressText}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Row="1" Margin="0,16,0,0" LastChildFill="False">
                <Button Content="Close"
                        Width="90"
                        DockPanel.Dock="Right"
                        Click="CloseButton_Click"
                        Margin="8,0,0,0" />
                                                <Button Width="110"
                        DockPanel.Dock="Right"
                        Command="{Binding ExportProjectCommand}"
                        Margin="0"
                        Tag="export.svg"
                        ToolTip="Export">
                    <Image Width="14"
                           Height="14"
                           Source="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Tag, Converter={StaticResource IconFileToImageSourceConverter}}" />
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</Window>







