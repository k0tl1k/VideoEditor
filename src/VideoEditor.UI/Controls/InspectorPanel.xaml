<UserControl x:Class="VideoEditor.UI.Controls.InspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PanelBorderStyle}">
        <StackPanel>
            <TextBlock Text="Effects" Style="{StaticResource TitleTextStyle}" />

            <TextBlock Text="Opacity" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
            <Slider Minimum="0" Maximum="100" Value="100" Margin="0,0,0,10" />

            <TextBlock Text="Scale" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
            <Slider Minimum="10" Maximum="300" Value="100" Margin="0,0,0,10" />

            <TextBlock Text="Rotation" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
            <Slider Minimum="-180" Maximum="180" Value="0" Margin="0,0,0,14" />

            <Button Content="Add Transition" />
            <Button Content="Add Color Filter" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>
