<Window x:Class="VideoEditor.UI.Windows.DeleteMediaConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete media"
        Width="460"
        Height="220"
        MinWidth="420"
        MinHeight="200"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Border Background="{StaticResource PanelChromeBrush}"
            BorderBrush="{StaticResource BorderBrushDark}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="0"
                              Color="#66000000"
                              Opacity="0.62" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <Border Width="36"
                        Height="36"
                        CornerRadius="11"
                        Background="#2D1E22"
                        BorderBrush="#7F2E38"
                        BorderThickness="1"
                        DockPanel.Dock="Left"
                        Margin="0,0,12,0">
                    <TextBlock Text="!"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="18"
                               FontWeight="Black" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderText}"
                               FontSize="18"
                               FontWeight="Black" />
                    <TextBlock Text="{Binding SubHeaderText}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               Margin="1,-2,0,0" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="{Binding MessageText}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding DetailsText}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           Margin="0,0,0,0" />
            </StackPanel>

            <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,14,0,0">
                <Button Content="Cancel"
                        Width="96"
                        DockPanel.Dock="Right"
                        IsCancel="True"
                        Click="CancelButton_Click"
                        Margin="8,0,0,0" />
                <Button Width="96"
                        DockPanel.Dock="Right"
                        Background="#3B2025"
                        BorderBrush="{StaticResource DangerBrush}"
                        Click="DeleteButton_Click"
                        Tag="trash.svg"
                        ToolTip="Delete">
                    <Image Width="14"
                           Height="14"
                           Source="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Tag, Converter={StaticResource IconFileToImageSourceConverter}}" />
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</Window>
