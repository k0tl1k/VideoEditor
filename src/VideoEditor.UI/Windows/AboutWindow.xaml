<Window x:Class="VideoEditor.UI.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Width="560"
        Height="420"
        MinWidth="520"
        MinHeight="380"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Border x:Name="RootBorder"
            Background="{StaticResource PanelChromeBrush}"
            BorderBrush="{StaticResource BorderBrushDark}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="18"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="0"
                              Color="#66000000"
                              Opacity="0.62" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <Border Width="42"
                        Height="42"
                        CornerRadius="12"
                        Background="#17253A"
                        BorderBrush="#33507A"
                        BorderThickness="1"
                        DockPanel.Dock="Left"
                        Margin="0,0,12,0">
                    <Image Width="22"
                           Height="22"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Tag="app-logo.svg"
                           Source="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource IconFileToImageSourceConverter}}" />
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VideoEditor"
                               FontSize="20"
                               FontWeight="Black" />
                    <TextBlock Text="About this application"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               Margin="1,-2,0,0" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1">
                <Border Background="#111A29"
                        BorderBrush="#273754"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Version"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" />
                        <TextBlock Text="{Binding AppVersionText}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#111A29"
                        BorderBrush="#273754"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Who made it"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" />
                        <TextBlock Text="Created by umrua with Codex"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#111A29"
                        BorderBrush="#273754"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="Why"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" />
                        <TextBlock Text="A timeline-based video editor for assembling video, audio, and images, previewing the result, and exporting it with FFmpeg."
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="Started as a compact MVP and grew into a practical desktop editor for quick монтаж and export workflows."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,14,0,0">
                <Button Width="96"
                        DockPanel.Dock="Right"
                        IsCancel="True"
                        Click="CloseButton_Click"
                        Margin="0">
                    Close
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</Window>
