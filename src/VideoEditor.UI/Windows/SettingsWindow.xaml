<Window x:Class="VideoEditor.UI.Windows.SettingsWindow"
        x:Name="SettingsRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="620"
        Height="520"
        MinWidth="560"
        MinHeight="440"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="KeyBadgeStyle" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="110" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="#0B1220" />
            <Setter Property="BorderBrush" Value="#345071" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="TextElement.FontWeight" Value="Bold" />
            <Setter Property="TextElement.FontSize" Value="11" />
        </Style>
        <Style x:Key="KeyBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>
    <Border x:Name="RootBorder"
            Background="{StaticResource PanelChromeBrush}"
            BorderBrush="{StaticResource BorderBrushDark}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="18"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="0"
                              Color="#66000000"
                              Opacity="0.62" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <Border Width="42"
                        Height="42"
                        CornerRadius="12"
                        Background="#17253A"
                        BorderBrush="#33507A"
                        BorderThickness="1"
                        DockPanel.Dock="Left"
                        Margin="0,0,12,0">
                    <TextBlock Text="S"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="18"
                               FontWeight="Black" />
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settings"
                               FontSize="20"
                               FontWeight="Black" />
                    <TextBlock Text="Editor preferences and keyboard shortcuts"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               Margin="1,-2,0,0" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#0D1521"
                        BorderBrush="#223554"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10">
                    <StackPanel>
                        <Border Background="#17324D"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,10">
                            <TextBlock Text="Hotkeys"
                                       FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="#111A29"
                        BorderBrush="#273754"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Keyboard shortcuts"
                                       FontSize="17"
                                       FontWeight="Black" />
                            <TextBlock Text="Current timeline shortcuts. Later we can make this list editable."
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding HotkeyRows, ElementName=SettingsRoot}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Section}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,8"
                                                       Visibility="{Binding HasSection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="128" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource KeyBadgeStyle}">
                                                    <TextBlock Text="{Binding Gesture}"
                                                               Style="{StaticResource KeyBadgeTextStyle}" />
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Description}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,16,0,0">
                <Button Width="96"
                        DockPanel.Dock="Right"
                        IsCancel="True"
                        Click="CloseButton_Click"
                        Margin="0">
                    Close
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</Window>
