<UserControl x:Class="VideoEditor.UI.Controls.ProjectPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PanelBorderStyle}">
        <DockPanel>
            <TextBlock Text="Project" Style="{StaticResource TitleTextStyle}" DockPanel.Dock="Top" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Margin="0,0,0,10"
                         Background="{StaticResource BgElevatedBrush}"
                         BorderBrush="{StaticResource BorderBrushDark}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Padding="8,4"
                         Text="Search media..." />

                <ListBox Grid.Row="1"
                         Background="{StaticResource BgElevatedBrush}"
                         BorderBrush="{StaticResource BorderBrushDark}"
                         Foreground="{StaticResource TextPrimaryBrush}">
                    <ListBoxItem Content="intro.mp4" />
                    <ListBoxItem Content="scene_01.mp4" />
                    <ListBoxItem Content="voiceover.wav" />
                    <ListBoxItem Content="logo.png" />
                </ListBox>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
