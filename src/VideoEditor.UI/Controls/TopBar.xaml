<UserControl x:Class="VideoEditor.UI.Controls.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="56">
    <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="14,10">
        <DockPanel LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="VideoEditor" FontSize="18" FontWeight="Bold" Margin="0,0,18,0"/>
                <Button Content="Import" Command="{Binding ImportMediaCommand}" />
                <Button Content="Trim" />
                <Button Content="Split" />
                <Button Content="Export" Margin="4,0,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Content="Undo" />
                <Button Content="Redo" Margin="0,0,0,0"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
