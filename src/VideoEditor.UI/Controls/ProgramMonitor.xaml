<UserControl x:Class="VideoEditor.UI.Controls.ProgramMonitor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Border Style="{StaticResource PanelBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26"
                            Height="26"
                            CornerRadius="8"
                            Background="#1D324A"
                            Margin="0,0,8,0">
                        <Image Width="14"
                               Height="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Tag="video.svg"
                               Source="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource IconFileToImageSourceConverter}}" />
                    </Border>
                    <TextBlock Text="Program Monitor"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding PreviewTitle}"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Grid.Column="1" />
            </Grid>

            <Border Grid.Row="1" Background="#05070B" BorderBrush="#2A3952" BorderThickness="1" CornerRadius="14" Padding="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#AA000000" Opacity="0.65" />
                </Border.Effect>
                <Grid>
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="1920" Height="1080" Background="#000000" ClipToBounds="True">
                            <MediaElement x:Name="PreviewMediaElement"
                                          Width="1920"
                                          Height="1080"
                                          Source="{Binding PreviewPlayableMediaSource}"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Stop"
                                          ScrubbingEnabled="True"
                                          Stretch="Uniform"
                                          Canvas.Left="{Binding PreviewFrameX}"
                                          Canvas.Top="{Binding PreviewFrameY}"
                                          RenderTransformOrigin="0.5,0.5"
                                          MediaOpened="PreviewMediaElement_MediaOpened"
                                          MediaEnded="PreviewMediaElement_MediaEnded"
                                          MediaFailed="PreviewMediaElement_MediaFailed"
                                          Visibility="{Binding IsPreviewPlayableMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <MediaElement.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding PreviewFrameScale}"
                                                    ScaleY="{Binding PreviewFrameScale}" />
                                </MediaElement.RenderTransform>
                            </MediaElement>

                            <ItemsControl ItemsSource="{Binding PreviewVisualLayers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="1920"
                                              Height="1080"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Scale}"
                                                                ScaleY="{Binding Scale}" />
                                            </Grid.RenderTransform>

                                            <MediaElement Source="{Binding Source}"
                                                          LoadedBehavior="Manual"
                                                          UnloadedBehavior="Stop"
                                                          ScrubbingEnabled="True"
                                                          Stretch="Uniform"
                                                          Loaded="PreviewVisualLayerMediaElement_Loaded"
                                                          Unloaded="PreviewVisualLayerMediaElement_Unloaded"
                                                          MediaOpened="PreviewVisualLayerMediaElement_MediaOpened"
                                                          MediaFailed="PreviewVisualLayerMediaElement_MediaFailed"
                                                          Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <Image Source="{Binding Source}"
                                                   Stretch="Uniform"
                                                   Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Viewbox>

                    <MediaElement x:Name="PreviewAudioElement"
                                  Source="{Binding PreviewAudioSource}"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  MediaOpened="PreviewAudioElement_MediaOpened"
                                  MediaFailed="PreviewAudioElement_MediaFailed"
                                  Visibility="Collapsed" />

                    <Border Background="#CC08101B"
                            BorderBrush="#33496A"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,6"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="8">
                        <TextBlock Text="{Binding PreviewStatusText}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" />
                    </Border>
                </Grid>
            </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="|&lt;" Width="44" Command="{Binding StopPreviewCommand}" />
                <Button Width="64"
                        ToolTip="Pause"
                        Tag="pause.svg"
                        Command="{Binding PausePreviewCommand}">
                    <Image Width="14"
                           Height="14"
                           Source="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Tag, Converter={StaticResource IconFileToImageSourceConverter}}" />
                </Button>
                <Button Width="72"
                        ToolTip="Play"
                        Tag="play.svg"
                        Command="{Binding PlayPreviewCommand}">
                    <Image Width="14"
                           Height="14"
                           Source="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Tag, Converter={StaticResource IconFileToImageSourceConverter}}" />
                </Button>
                <Button Width="64"
                        ToolTip="Stop"
                        Tag="stop.svg"
                        Command="{Binding StopPreviewCommand}"
                        Margin="0">
                    <Image Width="14"
                           Height="14"
                           Source="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Tag, Converter={StaticResource IconFileToImageSourceConverter}}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>


