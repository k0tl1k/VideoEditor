<UserControl x:Class="VideoEditor.UI.Controls.TimelinePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VideoEditor.UI.Controls"
             xmlns:conv="clr-namespace:VideoEditor.UI.Converters"
             Focusable="True"
             PreviewKeyDown="TimelinePanel_PreviewKeyDown"
             PreviewMouseWheel="TimelinePanel_PreviewMouseWheel">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="TimelineToolButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource ButtonChromeBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#17324D" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#162334" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TimelineIconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource ButtonChromeBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#162334" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1C2B40" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource PanelBorderStyle}" Padding="10,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26"
                            Height="26"
                            CornerRadius="8"
                            Background="#243552"
                            Margin="0,0,8,0">
                        <TextBlock Text="T"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentWarmBrush}"
                                   FontWeight="Black" />
                    </Border>
                    <TextBlock Text="Timeline"
                               FontSize="15"
                               FontWeight="Black"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,-1,0,0"
                               VerticalAlignment="Center" />
                    <ToggleButton Command="{Binding SelectTimelineMoveToolCommand}"
                                  IsChecked="{Binding IsMoveTimelineToolActive, Mode=OneWay}"
                                  Style="{StaticResource TimelineToolButtonStyle}"
                                  Margin="12,0,0,0"
                                  Tag="move.svg"
                                  ToolTip="Move tool">
                        <Image Width="14"
                               Height="14"
                               Stretch="Uniform"
                               Margin="2"
                               Source="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Tag, Converter={StaticResource IconFileToImageSourceConverter}}" />
                    </ToggleButton>
                    <ToggleButton Command="{Binding SelectTimelineRazorToolCommand}"
                                  IsChecked="{Binding IsRazorTimelineToolActive, Mode=OneWay}"
                                  Style="{StaticResource TimelineToolButtonStyle}"
                                  Tag="split.svg"
                                  ToolTip="Razor tool">
                        <Image Width="14"
                               Height="14"
                               Stretch="Uniform"
                               Margin="2"
                               Source="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Tag, Converter={StaticResource IconFileToImageSourceConverter}}" />
                    </ToggleButton>
                    <Button Command="{Binding SelectAllTimelineClipsCommand}"
                            ToolTip="Select all clips"
                            Width="44"
                            Height="36"
                            Margin="8,0,0,0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <TextBlock Text="All"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding TimelinePlaybackPositionLabel}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,18,0" />
                    <TextBlock Text="{Binding TimelineScaleLabel}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,12,0" />
                    <Slider Width="140"
                            Minimum="0"
                            Maximum="{Binding TimelineZoomMaxIndex}"
                            Value="{Binding TimelineZoomIndex}"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center" />
                    <Button ToolTip="Scroll timeline left"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0"
                            Padding="0"
                            Click="ScrollTimelineLeftButton_Click"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <TextBlock Text="‹"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,-2,0,0" />
                    </Button>
                    <Button ToolTip="Scroll timeline right"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0"
                            Padding="0"
                            Click="ScrollTimelineRightButton_Click"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <TextBlock Text="›"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,-2,0,0" />
                    </Button>
                    <Button Tag="zoom-out.svg"
                            ToolTip="Zoom out"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0"
                            Padding="0"
                            Click="ZoomOutTimelineButton_Click"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <Image Width="14"
                               Height="14"
                               Stretch="Uniform"
                               Margin="2"
                               Source="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Tag, Converter={StaticResource IconFileToImageSourceConverter}}" />
                    </Button>
                    <Button Tag="zoom-in.svg"
                            ToolTip="Zoom in"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0"
                            Padding="0"
                            Click="ZoomInTimelineButton_Click"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <Image Width="14"
                               Height="14"
                               Stretch="Uniform"
                               Margin="2"
                               Source="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Tag, Converter={StaticResource IconFileToImageSourceConverter}}" />
                    </Button>
                    <Button Command="{Binding AddVideoTrackCommand}"
                            Tag="video.svg"
                            ToolTip="Add video track"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <Image Width="14"
                               Height="14"
                               Stretch="Uniform"
                               Margin="2"
                               Source="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Tag, Converter={StaticResource IconFileToImageSourceConverter}}" />
                    </Button>
                    <Button Command="{Binding AddAudioTrackCommand}"
                            Tag="audio.svg"
                            ToolTip="Add audio track"
                            Width="36"
                            Height="36"
                            Margin="0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <Image Width="14"
                               Height="14"
                               Stretch="Uniform"
                               Margin="2"
                               Source="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Tag, Converter={StaticResource IconFileToImageSourceConverter}}" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    x:Name="TimelineRulerPanel"
                    Background="#101827"
                    BorderBrush="#2A3A55"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,0,0,8"
                    PreviewMouseLeftButtonDown="TimelineRulerPanel_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="TimelineRulerPanel_PreviewMouseLeftButtonUp"
                    PreviewMouseMove="TimelineRulerPanel_PreviewMouseMove">
                <Grid Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#0D1420"
                            BorderBrush="#2A3A55"
                            BorderThickness="0,0,1,0">
                        <TextBlock Text="Time"
                                   VerticalAlignment="Center"
                                   Margin="14,0"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </Border>

                    <Grid Grid.Column="1"
                          x:Name="TimelineRuler"
                          ClipToBounds="True"
                          Cursor="Hand">
                        <controls:TimelineRulerControl x:Name="VirtualTimelineRuler"
                                                       PixelsPerSecond="{Binding TimelinePixelsPerSecond}"
                                                       DurationSeconds="{Binding TimelineDurationSeconds}"
                                                       PlayheadCanvasLeft="{Binding TimelinePlayheadCanvasLeft}" />
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2"
                          x:Name="TimelineVerticalScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Background="#0B111C">
                <Grid Background="#0B111C">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Background="#0B111C" Padding="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="VIDEO TRACKS"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <ItemsControl ItemsSource="{Binding VideoTimelineTracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="58"
                                                    Margin="0,0,0,6"
                                                    Background="#111B2A"
                                                    BorderBrush="#263A57"
                                                    BorderThickness="1"
                                                    CornerRadius="4,0,0,4">
                                                <Grid VerticalAlignment="Center" Margin="12,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Header}" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Width="30"
                                                            Height="30"
                                                            Command="{Binding ToggleTrackEnabledCommand}"
                                                            Margin="6,0,0,0"
                                                            Padding="0"
                                                            ToolTip="{Binding ToggleTrackEnabledLabel}">
                                                        <Image Width="14"
                                                               Height="14"
                                                               Source="{Binding ToggleTrackEnabledIconName, Converter={StaticResource IconFileToImageSourceConverter}}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="#0B111C">
                            <StackPanel>
                                <TextBlock Text="AUDIO TRACKS"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <ItemsControl ItemsSource="{Binding AudioTimelineTracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="58"
                                                    Margin="0,0,0,6"
                                                    Background="#111B2A"
                                                    BorderBrush="#263A57"
                                                    BorderThickness="1"
                                                    CornerRadius="4,0,0,4">
                                                <Grid VerticalAlignment="Center" Margin="12,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Header}" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Width="30"
                                                            Height="30"
                                                            Command="{Binding ToggleTrackEnabledCommand}"
                                                            Margin="6,0,0,0"
                                                            Padding="0"
                                                            ToolTip="{Binding ToggleTrackEnabledLabel}">
                                                        <Image Width="14"
                                                               Height="14"
                                                               Source="{Binding ToggleTrackEnabledIconName, Converter={StaticResource IconFileToImageSourceConverter}}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                <ScrollViewer Grid.Column="1"
                               x:Name="TimelineScrollViewer"
                               HorizontalScrollBarVisibility="Hidden"
                               VerticalScrollBarVisibility="Disabled"
                               ScrollChanged="TimelineScrollViewer_ScrollChanged"
                               Background="#0B111C">
                    <Grid Width="{Binding TimelineCanvasWidth}"
                          HorizontalAlignment="Left">
                        <StackPanel Width="{Binding TimelineCanvasWidth}"
                                    HorizontalAlignment="Left">
                        <Border Background="#0B111C" Padding="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="VIDEO TRACKS"
                                           Foreground="Transparent"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"
                                           IsHitTestVisible="False" />

                                <ItemsControl ItemsSource="{Binding VideoTimelineTracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="58"
                                                    Margin="0,0,0,6"
                                                    Opacity="{Binding TrackOpacity}"
                                                    Background="#09111D"
                                                    BorderBrush="#1F3048"
                                                    BorderThickness="0,1,1,1"
                                                    CornerRadius="0,4,4,0"
                                                    AllowDrop="True"
                                                    DragEnter="TrackLane_DragEnter"
                                                    DragOver="TrackLane_DragOver"
                                                    DragLeave="TrackLane_DragLeave"
                                                    Drop="TrackLane_Drop"
                                                    ClipToBounds="True">
                                                <Canvas Width="{Binding DataContext.TimelineCanvasWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Height="58">
                                                    <Border Width="2"
                                                            Height="58"
                                                            Background="{StaticResource AccentBrush}"
                                                            Canvas.Left="{Binding DataContext.TimelinePlayheadCanvasLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Opacity="0.45" />
                                                    <ItemsControl ItemsSource="{Binding Clips}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                        <Border Width="{Binding Width}"
                                                                        Height="42"
                                                                        Margin="0,8,0,8"
                                                                        Opacity="{Binding ClipOpacity}"
                                                                        Background="{Binding BackgroundColor}"
                                                                        BorderBrush="{Binding BorderColor}"
                                                                        BorderThickness="{Binding BorderThickness}"
                                                                        Cursor="{Binding DataContext.IsRazorTimelineToolActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToTimelineCursorConverter}}"
                                                                        CornerRadius="4"
                                                                        PreviewMouseLeftButtonDown="Clip_PreviewMouseLeftButtonDown"
                                                                        PreviewMouseRightButtonDown="Clip_PreviewMouseRightButtonDown"
                                                                        PreviewMouseMove="Clip_PreviewMouseMove">
                                                                        <Border.ContextMenu>
                                                                            <ContextMenu>
                                                                                <MenuItem Header="Split clip"
                                                                                          Click="SplitClipMenuItem_Click" />
                                                                                <MenuItem Header="Unlink audio/video"
                                                                                          Click="UnlinkClipMenuItem_Click"
                                                                                          Visibility="{Binding IsLinkedClip, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                                <MenuItem Header="Delete clip only"
                                                                                          Click="DeleteClipMenuItem_Click" />
                                                                                <MenuItem Header="Delete linked group"
                                                                                          Click="DeleteLinkedClipMenuItem_Click"
                                                                                          Visibility="{Binding IsLinkedClip, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                            </ContextMenu>
                                                                        </Border.ContextMenu>
                                                                          <Grid>
                                                                              <Border Width="4"
                                                                                      HorizontalAlignment="Left"
                                                                                      Background="{Binding AccentColor}"
                                                                                      CornerRadius="4,0,0,4" />
                                                                              <Border Width="4"
                                                                                      HorizontalAlignment="Right"
                                                                                      Background="{Binding AccentColor}"
                                                                                      CornerRadius="0,4,4,0" />
                                                                              <TextBlock Text="{Binding DisplayName}"
                                                                                         Margin="12,0,10,0"
                                                                                         VerticalAlignment="Center"
                                                                                         TextTrimming="CharacterEllipsis" />
                                                                        <Border Width="10"
                                                                                HorizontalAlignment="Left"
                                                                                Background="Transparent"
                                                                                Cursor="SizeWE"
                                                                                Tag="Left"
                                                                                ToolTip="Trim start"
                                                                                PreviewMouseLeftButtonDown="TrimHandle_PreviewMouseLeftButtonDown"
                                                                                PreviewMouseMove="TrimHandle_PreviewMouseMove"
                                                                                PreviewMouseLeftButtonUp="TrimHandle_PreviewMouseLeftButtonUp" />
                                                                        <Border Width="10"
                                                                                HorizontalAlignment="Right"
                                                                                Background="Transparent"
                                                                                Cursor="SizeWE"
                                                                                Tag="Right"
                                                                                ToolTip="Trim end"
                                                                                PreviewMouseLeftButtonDown="TrimHandle_PreviewMouseLeftButtonDown"
                                                                                PreviewMouseMove="TrimHandle_PreviewMouseMove"
                                                                                PreviewMouseLeftButtonUp="TrimHandle_PreviewMouseLeftButtonUp" />
                                                                        <Border Width="18"
                                                                                Height="18"
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Top"
                                                                                Margin="0,5,6,0"
                                                                                Background="#1B2A3F"
                                                                                BorderBrush="{Binding AccentColor}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="9"
                                                                                Visibility="{Binding IsLinkedClip, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                ToolTip="Linked clip">
                                                                            <TextBlock Text="⛓"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"
                                                                                       Foreground="{Binding AccentColor}"
                                                                                       FontSize="9"
                                                                                       FontWeight="Bold" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border Background="Transparent"
                                                            Width="{Binding DataContext.TimelineCanvasWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Height="58"
                                                            Panel.ZIndex="10"
                                                            Canvas.Left="0"
                                                            Canvas.Top="0"
                                                            IsHitTestVisible="{Binding DataContext.IsSelectTimelineToolActive, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            PreviewMouseLeftButtonDown="SelectionOverlay_PreviewMouseLeftButtonDown"
                                                            PreviewMouseMove="SelectionOverlay_PreviewMouseMove"
                                                            PreviewMouseLeftButtonUp="SelectionOverlay_PreviewMouseLeftButtonUp" />
                                                </Canvas>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="#0B111C">
                            <StackPanel>
                                <TextBlock Text="AUDIO TRACKS"
                                           Foreground="Transparent"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"
                                           IsHitTestVisible="False" />

                                <ItemsControl ItemsSource="{Binding AudioTimelineTracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="58"
                                                    Margin="0,0,0,6"
                                                    Opacity="{Binding TrackOpacity}"
                                                    Background="#09111D"
                                                    BorderBrush="#1F3048"
                                                    BorderThickness="0,1,1,1"
                                                    CornerRadius="0,4,4,0"
                                                    AllowDrop="True"
                                                    DragEnter="TrackLane_DragEnter"
                                                    DragOver="TrackLane_DragOver"
                                                    DragLeave="TrackLane_DragLeave"
                                                    Drop="TrackLane_Drop"
                                                    ClipToBounds="True">
                                                <Canvas Width="{Binding DataContext.TimelineCanvasWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Height="58">
                                                    <Border Width="2"
                                                            Height="58"
                                                            Background="{StaticResource AccentBrush}"
                                                            Canvas.Left="{Binding DataContext.TimelinePlayheadCanvasLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Opacity="0.45" />
                                                    <ItemsControl ItemsSource="{Binding Clips}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="{Binding Width}"
                                                                        Height="42"
                                                                        Margin="0,8,0,8"
                                                                        Opacity="{Binding ClipOpacity}"
                                                                        Background="{Binding BackgroundColor}"
                                                                        BorderBrush="{Binding BorderColor}"
                                                                        BorderThickness="{Binding BorderThickness}"
                                                                        Cursor="{Binding DataContext.IsRazorTimelineToolActive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToTimelineCursorConverter}}"
                                                                        CornerRadius="4"
                                                                        PreviewMouseLeftButtonDown="Clip_PreviewMouseLeftButtonDown"
                                                                        PreviewMouseRightButtonDown="Clip_PreviewMouseRightButtonDown"
                                                                        PreviewMouseMove="Clip_PreviewMouseMove">
                                                                    <Border.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="Split clip"
                                                                                      Click="SplitClipMenuItem_Click" />
                                                                            <MenuItem Header="Delete clip only"
                                                                                      Click="DeleteClipMenuItem_Click" />
                                                                            <MenuItem Header="Delete linked group"
                                                                                      Click="DeleteLinkedClipMenuItem_Click"
                                                                                      Visibility="{Binding IsLinkedClip, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                        </ContextMenu>
                                                                    </Border.ContextMenu>
                                                                      <Grid>
                                                                          <controls:AudioWaveformControl Peaks="{Binding WaveformPeaks}"
                                                                                                         Margin="8,5,8,5"
                                                                                                         Opacity="0.72"
                                                                                                         IsHitTestVisible="False" />
                                                                          <Border Width="4"
                                                                                  HorizontalAlignment="Left"
                                                                                  Background="{Binding AccentColor}"
                                                                                  CornerRadius="4,0,0,4" />
                                                                          <Border Width="4"
                                                                                  HorizontalAlignment="Right"
                                                                                  Background="{Binding AccentColor}"
                                                                                  CornerRadius="0,4,4,0" />
                                                                          <TextBlock Text="{Binding DisplayName}"
                                                                                     Margin="12,0,10,0"
                                                                                     VerticalAlignment="Center"
                                                                                     TextTrimming="CharacterEllipsis" />
                                                                          <Border Width="10"
                                                                                  HorizontalAlignment="Left"
                                                                                  Background="Transparent"
                                                                                  Cursor="SizeWE"
                                                                                  Tag="Left"
                                                                                  ToolTip="Trim start"
                                                                                  PreviewMouseLeftButtonDown="TrimHandle_PreviewMouseLeftButtonDown"
                                                                                  PreviewMouseMove="TrimHandle_PreviewMouseMove"
                                                                                  PreviewMouseLeftButtonUp="TrimHandle_PreviewMouseLeftButtonUp" />
                                                                          <Border Width="10"
                                                                                  HorizontalAlignment="Right"
                                                                                  Background="Transparent"
                                                                                  Cursor="SizeWE"
                                                                                  Tag="Right"
                                                                                  ToolTip="Trim end"
                                                                                  PreviewMouseLeftButtonDown="TrimHandle_PreviewMouseLeftButtonDown"
                                                                                  PreviewMouseMove="TrimHandle_PreviewMouseMove"
                                                                                  PreviewMouseLeftButtonUp="TrimHandle_PreviewMouseLeftButtonUp" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border Background="Transparent"
                                                            Width="{Binding DataContext.TimelineCanvasWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Height="58"
                                                            Panel.ZIndex="10"
                                                            Canvas.Left="0"
                                                            Canvas.Top="0"
                                                            IsHitTestVisible="{Binding DataContext.IsSelectTimelineToolActive, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            PreviewMouseLeftButtonDown="SelectionOverlay_PreviewMouseLeftButtonDown"
                                                            PreviewMouseMove="SelectionOverlay_PreviewMouseMove"
                                                            PreviewMouseLeftButtonUp="SelectionOverlay_PreviewMouseLeftButtonUp" />
                                                </Canvas>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                        <Canvas x:Name="TimelineSelectionOverlay"
                                IsHitTestVisible="False"
                                Width="{Binding TimelineCanvasWidth}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Panel.ZIndex="100" />
                    </Grid>
                </ScrollViewer>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="3"
                    Margin="118,4,0,0"
                    Background="#091019"
                    BorderBrush="#1A2940"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="4,2,4,2">
                <Border.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                        <Setter Property="Height" Value="10" />
                        <Setter Property="Background" Value="#091019" />
                    </Style>
                </Border.Resources>
                <ScrollBar x:Name="TimelineHorizontalScrollBar"
                           Orientation="Horizontal"
                           Height="10"
                           Minimum="0"
                           Maximum="0"
                           ValueChanged="TimelineHorizontalScrollBar_ValueChanged" />
            </Border>
        </Grid>
    </Border>
</UserControl>





