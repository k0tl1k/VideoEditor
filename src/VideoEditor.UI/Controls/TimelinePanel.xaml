<UserControl x:Class="VideoEditor.UI.Controls.TimelinePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PanelBorderStyle}" Padding="10,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Timeline" Style="{StaticResource TitleTextStyle}" Margin="0" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="-" Width="34" />
                    <Button Content="+" Width="34" Margin="0" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1A2028" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                    <Grid>
                        <TextBlock Text="V1" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource TextMutedBrush}" />
                        <Border Width="220" Height="32" HorizontalAlignment="Left" Margin="58,10,0,10" Background="#3A4A63" CornerRadius="3">
                            <TextBlock Text="scene_01" VerticalAlignment="Center" Margin="10,0" />
                        </Border>
                        <Border Width="170" Height="32" HorizontalAlignment="Left" Margin="292,10,0,10" Background="#4F3E6E" CornerRadius="3">
                            <TextBlock Text="intro" VerticalAlignment="Center" Margin="10,0" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#1A2028" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <TextBlock Text="A1" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource TextMutedBrush}" />
                        <Border Width="300" Height="32" HorizontalAlignment="Left" Margin="58,10,0,10" Background="#2E6A57" CornerRadius="3">
                            <TextBlock Text="voiceover" VerticalAlignment="Center" Margin="10,0" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
